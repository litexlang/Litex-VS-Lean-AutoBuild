# 忽略实验输出目录（用户自己的运行结果）
litex_auto_validated_250tasks/definitions_only/run_*/
litex_auto_validated_250tasks/theorems_only/run_*/

# 但保留目录结构
!litex_auto_validated_250tasks/definitions_only/.gitkeep
!litex_auto_validated_250tasks/theorems_only/.gitkeep

# 忽略API配置文件（包含密钥）
config/api_config.json

# 但保留示例配置
!config/api_config.example.json

# 忽略临时日志文件
*.log
nohup.out
definition_*.log
theorem_*.log
def_run.log
thm_run.log

# 忽略Python缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 忽略IDE配置
.vscode/
.idea/
*.swp
*.swo

# 忽略系统文件
.DS_Store
Thumbs.db
